#    Estas son las variables de entorno que debes configurar en un archivo .env, usando el formato 
#    Clave=Valor. Sirven para separar la CONFIGURACIÓN del código fuente, 
#    protegiendo datos sensibles (como contraseñas) de accesos no autorizados.
# 
#    El archivo 'conexion.py' SOLO se encarga de "abrir la puerta y entregar la 
#    llave" de la base de datos.
#
#    Bajo ninguna circunstancia compartas tu archivo .env con credenciales reales.
#    Este archivo .env.local sirve como ejemplo de configuración, asi que puede compartirse libremente
#    
#    NOTA: La contraseña del correo, no es la de tu cuenta, sino una "contraseña de aplicación"

# CONFIGURACIÓN DE LA BASE DE DATOS
DB_HOST=localhost
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database
DB_PORT=3306

# CONFIGURACIÓN DEL CORREO (NOTIFICACIONES)
EMAIL_REMITENTE=your_email@example.com
EMAIL_PASSWORD=your_email_password

# CONFIGURACIÓN JWT (AUTENTICACIÓN)
JWT_SECRET_KEY=your_super_secret_key_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480